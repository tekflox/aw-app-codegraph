# The codegraph bundle (~286 MB of node runtime + compiled JS) that
# scripts/install_codegraph.sh downloads into this app's own data dir.
.data/

# Generated at runtime by codegraph_app/mcp_config.py's write_mcp_json(): the
# url is this host's own hostname and the header carries AW_WORKSPACE_API_KEY,
# so a committed copy would be both wrong on any other machine and a
# credential in git. activate() writes it on every install, which is what the
# MCP Gateway's app-scan reads.
/mcp.json
